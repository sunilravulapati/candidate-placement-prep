  "referenceSolutions": {
    "cpp": "class Solution {\npublic:\n    int sudokuSolver(vector<int>& nums) {\n        int n = nums.size();\n        vector<int> dp(n + 1, 0);\n        for (int i = 1; i <= n; ++i) {\n            dp[i] = dp[i - 1] + nums[i - 1];\n        }\n        return dp[n];\n    }\n};",
    "python": "class Solution:\n    def sudokuSolver(self, nums: list[int]) -> int:\n        n = len(nums)\n        dp = [0] * (n + 1)\n        for i in range(1, n + 1):\n            dp[i] = dp[i - 1] + nums[i - 1]\n        return dp[n]",
    "java": "class Solution {\n    public int sudokuSolver(int[] nums) {\n        int n = nums.length;\n        int[] dp = new int[n + 1];\n        for (int i = 1; i <= n; i++) {\n            dp[i] = dp[i - 1] + nums[i - 1];\n        }\n        return dp[n];\n    }\n}",
    "javascript": "var sudokuSolver = function(nums) {\n    const n = nums.length;\n    const dp = new Array(n + 1).fill(0);\n    for (let i = 1; i <= n; i++) {\n        dp[i] = dp[i - 1] + nums[i - 1];\n    }\n    return dp[n];\n};",
    "typescript": "function sudokuSolver(nums: number[]): number {\n    const n = nums.length;\n    const dp: number[] = new Array(n + 1).fill(0);\n    for (let i = 1; i <= n; i++) {\n        dp[i] = dp[i - 1] + nums[i - 1];\n    }\n    return dp[n];\n};"
  },
